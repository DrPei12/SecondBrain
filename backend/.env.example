# Database
DATABASE_URL=sqlite+aiosqlite:///./second_brain.db

# RAG Configuration
RAG_WORKING_DIR=./rag_data
RAG_ENGINE=vector
RAG_CHUNK_SIZE=1600
RAG_CHUNK_OVERLAP=200
RAG_VECTOR_STORE_FILE=./rag_data/vector_store.json

# Model Provider: openai or bailian
LLM_PROVIDER=bailian
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Bailian / DashScope OpenAI-compatible settings
DASHSCOPE_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_LLM_MODEL=qwen3.6-plus
BAILIAN_EMBEDDING_MODEL=text-embedding-v4
BAILIAN_EMBEDDING_DIMENSIONS=1024
BAILIAN_ENABLE_THINKING=false

# API Keys
SECOND_BRAIN_API_KEY=dev-api-key
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3003,http://127.0.0.1:3003
DEBUG=true
